nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    test("-profile test") {

        when {
            params {
                outdir         = "$outputDir"
                // Also referenced in `then`: `params` there resolves against this
                // block, not conf/test.config, so it must be declared here.
                target_species = 'Mycoplasma_agalactiae'
            }
        }

        then {
            def summary   = file("${params.outdir}/extract/orthogroup_summary.tsv").readLines()
            // Located by name: this was hardcoded to the wrong index once, and a
            // wrong index silently counts zero rather than failing.
            def statusIdx = summary[0].split('\t').findIndexOf { it == 'status' }
            def kept      = summary.drop(1).count { it.split('\t')[statusIdx] == 'kept' }

            def ks_files = file("${params.outdir}/codeml").listFiles()
                               .findAll { it.name.endsWith('_ks.tsv') }
                               .sort { it.name }
            def header   = ks_files ? ks_files[0].readLines()[0] : ''
            def columns  = header.split('\t') as List
            def rows     = ks_files.collectMany { it.readLines().drop(1) }

            // Every column below is looked up by name for the same reason the
            // status column is: inserting a column shifts every index after it,
            // and a stale index reads a neighbouring column rather than failing.
            def col = { row, name -> row.split('\t')[columns.indexOf(name)] }

            assertAll(
                { assert workflow.success },

                // Guards the lookups: findIndexOf/indexOf return -1 on a rename.
                { assert statusIdx >= 0 },

                // Every selected orthogroup produced a dS table.
                { assert kept > 0 },
                { assert ks_files.size() == kept },

                // The column set is the contract downstream analysis reads.
                // Asserted literally rather than snapshotted: the numbers are ML
                // estimates and not bit-stable across PAML builds or platforms,
                // so there is nothing else in these files worth snapshotting.
                { assert columns == [
                    'orthogroup', 'species', 'gene_a', 'gene_b', 'n_seqs_alignment',
                    'n_codons_alignment', 'has_tree', 'crosschecked', 'n_codons_pair',
                    'pct_id_a_in_b', 'pct_id_b_in_a', 'tree_dS', 'tree_dN', 'tree_omega',
                    'pair_dS', 'pair_dN', 'pair_omega', 'pair_t', 'pair_S', 'pair_N',
                    'yn00_dS', 'yn00_dN', 'yn00_omega', 'm0_omega', 'm0_kappa', 'm0_lnL',
                    'dS_tree_over_pair'
                ] },

                // The tree-based estimate must actually run. It degraded
                // silently to pairwise-only once before, when OrthoFinder
                // changed where and how it writes gene trees, and nothing in
                // the pipeline failed to signal it.
                { assert rows.any { col(it, 'has_tree') == 'yes' } },
                { assert rows.any { col(it, 'tree_dS') != 'NA' } },

                // Every reported pair belongs to a single species: pairs are formed
                // within a species, so an ortholog pair must never appear.
                { assert rows.every { col(it, 'species') == params.target_species } },

                // The fitted trees are published alongside the tables.
                { assert file("${params.outdir}/codeml/trees").listFiles()
                             .count { it.name.endsWith('_dS.nwk') } > 0 },

                // Both cross-checks should produce numbers for at least some pairs.
                { assert rows.any { col(it, 'pair_dS') != 'NA' } },
                { assert rows.any { col(it, 'yn00_dS') != 'NA' } },

                // A pair the cross-checks were sampled out of keeps its
                // tree-based dS and says so, rather than looking like a failure.
                { assert rows.every { col(it, 'crosschecked') in ['yes', 'no'] } },
                { assert rows.every {
                    col(it, 'crosschecked') == 'yes' || col(it, 'pair_dS') == 'NA'
                } },
            )
        }
    }
}
